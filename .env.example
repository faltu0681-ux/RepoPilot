# Copy to .env and fill in real values. .env is gitignored: never commit it.
# Every value below is the built-in default, so an empty file works too.

# --- API ---
REPOPILOT_HOST=127.0.0.1
REPOPILOT_PORT=8000
REPOPILOT_LOG_LEVEL=info

# --- Frontend CORS ---
REPOPILOT_CORS_ORIGINS=http://localhost:5173

# --- GitHub ---
# Needed for private repos and for opening pull requests. Leave empty for public read-only.
# Create one at https://github.com/settings/tokens (scope: repo)
REPOPILOT_GITHUB_TOKEN=

# --- Workspace ---
# Where each run's checkout is created. Gitignored.
# Each run gets its own isolated checkout: <workspace>/<owner>__<repo>/<run_id>
REPOPILOT_WORKSPACE_DIR=./.repopilot-data

# --- Local repositories ---
# Where the folders a run can be pointed at with local://<folder> live, one per directory.
# Gitignored, and never written to: a local run copies the folder into the workspace above and
# works on the copy, so your files are unchanged afterwards.
REPOPILOT_REPOSITORIES_DIR=./workspaces

# --- LLM (Phase 2 reasoning backend) ---
# RepoPilot needs a model to turn a task into an implementation plan. Both values below
# are empty by default, which means "unconfigured": the API still starts, and a run that
# needs reasoning fails with a message naming these settings instead of calling anything.
#
# Any OpenAI-compatible endpoint works, so the same client covers OpenAI, Ollama,
# OpenRouter, vLLM, and LM Studio. Set REPOPILOT_LLM_DIALECT=anthropic for Anthropic.
#
#   OpenAI     REPOPILOT_LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter REPOPILOT_LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama     REPOPILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1   (no key needed)
#   Anthropic  REPOPILOT_LLM_BASE_URL=https://api.anthropic.com  + dialect=anthropic
REPOPILOT_LLM_API_KEY=
REPOPILOT_LLM_BASE_URL=
REPOPILOT_LLM_MODEL=
REPOPILOT_LLM_DIALECT=openai
REPOPILOT_LLM_TIMEOUT=120
REPOPILOT_LLM_MAX_TOKENS=4096

# --- Tests (Phase 2C) ---
# Wall-clock limit for one run of the repository's test suite, in seconds.
# A run that exceeds it is reported as timed out, not as a failing test, and is not retried.
# Must be greater than 0 and at most 7200.
REPOPILOT_TEST_TIMEOUT_SECONDS=600

# --- Execution environment (V1) ---
# Where a run's untrusted commands execute. This is the setting that decides whether the agent's
# code runs on your machine or inside a container.
#
#   local  (default) a child process on this host. Restricted to the run's workspace directory and
#          a filtered environment, with NO filesystem, network, or resource isolation. Convenient,
#          and appropriate only for code you trust.
#   docker           a throwaway container per command, with only the run's checkout mounted, no
#          network, and CPU/memory/process caps. Requires Docker. See docs/architecture.md for the
#          threat model, including what Docker does NOT protect you from.
#
# Setting 'docker' without Docker installed fails the run with that remedy, rather than silently
# falling back to the host.
REPOPILOT_EXECUTION_BACKEND=local

# Image commands run in. One image cannot hold every language runtime, so this is per stack: pick
# one that matches the repository. A mismatch produces an honest UNVERIFIED run rather than a
# misleading failure. Pin a tag rather than 'latest' so a verdict cannot change under you.
REPOPILOT_SANDBOX_IMAGE=python:3.12-slim

# Container network. 'none' by default, and it should stay that way unless you have a specific
# reason: any other value lets the code under test make outbound requests.
REPOPILOT_SANDBOX_NETWORK=none

# Resource caps, so a runaway suite or a fork bomb ends the run instead of the machine.
# Swap is pinned equal to memory, which disables overcommit.
REPOPILOT_SANDBOX_MEMORY=2g
REPOPILOT_SANDBOX_CPUS=2
REPOPILOT_SANDBOX_PIDS_LIMIT=512

# Ceiling for starting a container, which may need to pull the image first. Separate from the
# suite timeout because the first command of a run can legitimately take much longer than the tests.
REPOPILOT_SANDBOX_STARTUP_TIMEOUT_SECONDS=300

# Container user. Empty means the image's own user; a non-root uid such as 1000:1000 is better, but
# it is not the default because it silently breaks images that write to root-owned paths.
REPOPILOT_SANDBOX_USER=

# The container CLI to shell out to. Overridable so the test suite can point at a fake docker and
# assert on the exact argv; almost nobody needs to change it.
REPOPILOT_SANDBOX_DOCKER_BINARY=docker

# Note: no REPOPILOT_* variable is ever forwarded into the container. The sandbox's environment is
# built from an allowlist, so the GitHub token and the LLM key cannot reach the code under test.
