# Copy to .env and fill in real values. .env is gitignored: never commit it.
# Every value below is the built-in default, so an empty file works too.

# --- API ---
REPOPILOT_HOST=127.0.0.1
REPOPILOT_PORT=8000
REPOPILOT_LOG_LEVEL=info

# --- Frontend CORS ---
REPOPILOT_CORS_ORIGINS=http://localhost:5173

# --- GitHub ---
# Needed for private repos and for opening pull requests. Leave empty for public read-only.
# Create one at https://github.com/settings/tokens (scope: repo)
REPOPILOT_GITHUB_TOKEN=

# --- Workspace ---
# Where repositories get cloned. Gitignored.
# Each run gets its own isolated checkout: <workspace>/<owner>__<repo>/<run_id>
REPOPILOT_WORKSPACE_DIR=./.repopilot-data

# --- LLM (Phase 2 reasoning backend) ---
# RepoPilot needs a model to turn a task into an implementation plan. Both values below
# are empty by default, which means "unconfigured": the API still starts, and a run that
# needs reasoning fails with a message naming these settings instead of calling anything.
#
# Any OpenAI-compatible endpoint works, so the same client covers OpenAI, Ollama,
# OpenRouter, vLLM, and LM Studio. Set REPOPILOT_LLM_DIALECT=anthropic for Anthropic.
#
#   OpenAI     REPOPILOT_LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter REPOPILOT_LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama     REPOPILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1   (no key needed)
#   Anthropic  REPOPILOT_LLM_BASE_URL=https://api.anthropic.com  + dialect=anthropic
REPOPILOT_LLM_API_KEY=
REPOPILOT_LLM_BASE_URL=
REPOPILOT_LLM_MODEL=
REPOPILOT_LLM_DIALECT=openai
REPOPILOT_LLM_TIMEOUT=120
REPOPILOT_LLM_MAX_TOKENS=4096

# --- Tests (Phase 2C) ---
# Wall-clock limit for one run of the repository's test suite, in seconds.
# A run that exceeds it is reported as timed out, not as a failing test, and is not retried.
# Must be greater than 0 and at most 7200.
REPOPILOT_TEST_TIMEOUT_SECONDS=600
