# ---- Secrets: never commit these ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json
*_rsa
*_ed25519
id_rsa*
id_ed25519*
.github-token
gh_token
GITHUB_TOKEN
GITHUB_PAT

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ---- Node / frontend ----
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Repopilot runtime artefacts ----
# Cloned repositories, run logs, and anything the engine writes to disk.
# Each run gets an isolated checkout here: <workspace_dir>/<owner>__<repo>/<run_id>
.repopilot-data/
repopilot-data/
.runs/
*.log

# ---- Repository workspaces (Phase 4) ----
# Repositories the user drops in for RepoPilot to work on. The application source lives in apps/
# and packages/, so nothing here can shadow it.
#
# Only the README is tracked, so the directory exists in a fresh clone: an empty directory is not
# something git can hold on to.
workspaces/*
!workspaces/README.md
